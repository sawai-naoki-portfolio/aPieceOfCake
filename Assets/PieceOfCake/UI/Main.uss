/* Piece of Cake — UI styles. Palette follows the HTML prototype (pastel cake colours). */

.root {
    flex-grow: 1;
    color: rgb(90, 52, 36);
    -unity-font-style: bold;
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hidden {
    display: none;
}

/* ---------------------------------------------------------------- HUD */

.hud-left {
    position: absolute;
    left: 12px;
    top: 12px;
    align-items: flex-start;
}

.hud-right {
    position: absolute;
    right: 12px;
    top: 12px;
    flex-direction: row;
}

.pill {
    background-color: rgba(255, 250, 244, 0.92);
    border-width: 2px;
    border-color: rgb(231, 185, 163);
    border-radius: 14px;
    padding: 4px 14px;
    margin-bottom: 6px;
}

.stage-pill {
    color: rgb(194, 71, 91);
    font-size: 18px;
}

.order-pill {
    flex-direction: row;
    align-items: center;
    font-size: 15px;
    color: rgb(122, 74, 42);
}

.order-icon {
    width: 20px;
    height: 16px;
    margin-right: 8px;
    background-color: rgb(243, 196, 110);
    border-top-width: 5px;
    border-color: rgb(255, 255, 255);
    border-radius: 3px;
}

.order-icon.empty {
    opacity: 0.3;
}

.order-label {
    margin-right: 14px;
}

.power-row {
    flex-direction: row;
}

.power-pill {
    flex-direction: row;
    align-items: center;
    margin-right: 6px;
    font-size: 13px;
    color: rgb(122, 74, 42);
}

.power-label {
    margin-right: 6px;
}

.power-track {
    width: 60px;
    height: 9px;
    border-radius: 5px;
    background-color: rgba(122, 74, 42, 0.15);
}

.power-fill {
    height: 100%;
    border-radius: 5px;
}

.power-fill.strawberry {
    background-color: rgb(242, 98, 124);
}

.power-fill.chocolate {
    background-color: rgb(139, 86, 52);
}

.small-button {
    min-width: 96px;
    height: 44px;
    margin-left: 8px;
    border-radius: 14px;
    border-width: 2px;
    border-bottom-width: 5px;
    border-color: rgb(210, 154, 130);
    background-color: rgba(255, 250, 244, 0.95);
    color: rgb(122, 74, 42);
    font-size: 15px;
    -unity-font-style: bold;
}

.banner {
    position: absolute;
    left: 50%;
    top: 26%;
    width: 380px;
    margin-left: -190px;
    padding: 12px 18px;
    background-color: rgba(255, 248, 240, 0.96);
    border-width: 3px;
    border-color: rgb(243, 205, 184);
    border-radius: 20px;
    align-items: center;
}

.banner-stage {
    color: rgb(232, 86, 108);
    font-size: 18px;
}

.banner-name {
    font-size: 26px;
    color: rgb(107, 67, 48);
}

.toast {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 40%;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: rgb(255, 255, 255);
    background-color: rgba(90, 52, 36, 0.88);
    border-radius: 16px;
    padding: 12px 20px;
}

/* ---------------------------------------------------------------- Speech bubbles */

.bubble {
    position: absolute;
    max-width: 320px;
    padding: 6px 12px;
    font-size: 17px;
    white-space: normal;
    -unity-text-align: middle-center;
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgb(231, 169, 182);
    border-radius: 12px;
    color: rgb(90, 52, 36);
}

.bubble.sign {
    background-color: rgb(255, 253, 245);
    border-color: rgb(185, 139, 94);
}

.bubble.customer {
    border-color: rgb(226, 183, 163);
}

/* ---------------------------------------------------------------- Touch controls */

.touch .pad {
    position: absolute;
    left: 24px;
    bottom: 24px;
    flex-direction: row;
}

.pad-button {
    width: 92px;
    height: 92px;
    margin-right: 14px;
    border-radius: 26px;
    background-color: rgba(255, 248, 240, 0.85);
    border-width: 3px;
    border-bottom-width: 7px;
    border-color: rgb(233, 184, 160);
    align-items: center;
    justify-content: center;
}

.pad-glyph {
    font-size: 34px;
    color: rgb(138, 79, 51);
}

.action-buttons {
    position: absolute;
    right: 24px;
    bottom: 24px;
    flex-direction: row;
    align-items: center;
}

.action-column {
    margin-right: 14px;
}

.action-button {
    width: 84px;
    height: 84px;
    margin-top: 12px;
    border-radius: 42px;
    border-width: 3px;
    border-bottom-width: 7px;
    border-color: rgba(255, 255, 255, 0.8);
    align-items: center;
    justify-content: center;
}

.action-button.jump {
    width: 108px;
    height: 108px;
    border-radius: 54px;
    background-color: rgb(242, 125, 143);
}

.action-button.eat {
    background-color: rgb(240, 174, 60);
}

.action-button.cut {
    background-color: rgb(111, 174, 227);
}

.action-glyph {
    font-size: 18px;
    color: rgb(255, 255, 255);
}

.pressed {
    translate: 0 4px;
    border-bottom-width: 3px;
}

/* ---------------------------------------------------------------- Screens */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(58, 34, 25, 0.5);
    align-items: center;
    justify-content: center;
    padding: 14px;
}

.card {
    width: 92%;
    max-width: 580px;
    max-height: 100%;
    background-color: rgb(255, 248, 240);
    border-width: 3px;
    border-bottom-width: 9px;
    border-color: rgb(243, 205, 184);
    border-bottom-color: rgb(226, 183, 159);
    border-radius: 24px;
    padding: 18px 22px 20px 22px;
    align-items: center;
}

.card.wide {
    max-width: 900px;
}

.logo-small {
    font-size: 15px;
    letter-spacing: 6px;
    color: rgb(185, 129, 79);
}

.logo {
    font-size: 48px;
    color: rgb(232, 86, 108);
    margin-bottom: 4px;
}

.tagline {
    color: rgb(154, 106, 76);
    font-size: 18px;
    margin-bottom: 12px;
}

.how-to {
    align-self: stretch;
    background-color: rgb(255, 240, 227);
    border-radius: 14px;
    padding: 10px 14px;
    margin-bottom: 12px;
}

.how-row {
    flex-direction: row;
    margin-bottom: 4px;
}

.how-key {
    width: 70px;
    color: rgb(194, 71, 91);
    font-size: 15px;
}

.how-text {
    flex-shrink: 1;
    flex-grow: 1;
    white-space: normal;
    font-size: 15px;
    color: rgb(107, 67, 48);
    -unity-font-style: normal;
}

.rotate-hint {
    color: rgb(194, 71, 91);
    font-size: 14px;
    margin-bottom: 6px;
}

.key-hint {
    color: rgb(160, 122, 98);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
    -unity-font-style: normal;
}

.heading {
    color: rgb(194, 71, 91);
    font-size: 28px;
    margin-bottom: 12px;
}

.button {
    min-width: 220px;
    margin: 5px;
    padding: 10px 18px;
    font-size: 19px;
    -unity-font-style: bold;
    border-radius: 16px;
    border-width: 0;
    border-bottom-width: 5px;
    border-color: rgb(226, 176, 140);
    background-color: rgb(255, 227, 201);
    color: rgb(122, 74, 42);
}

.button:hover,
.button:focus {
    background-color: rgb(255, 236, 216);
}

.button.primary {
    background-color: rgb(242, 125, 143);
    border-color: rgb(201, 86, 106);
    color: rgb(255, 255, 255);
}

.button.primary:hover,
.button.primary:focus {
    background-color: rgb(246, 145, 161);
}

.button:active {
    translate: 0 3px;
    border-bottom-width: 2px;
}

.button-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.stage-list {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 12px;
}

.stage-card {
    width: 158px;
    margin: 6px;
    padding: 12px 8px;
    border-radius: 16px;
    border-width: 0;
    border-bottom-width: 5px;
    border-color: rgb(229, 183, 152);
    background-color: rgb(255, 235, 221);
    align-items: center;
    flex-direction: column;
}

.stage-card:hover,
.stage-card:focus {
    background-color: rgb(255, 243, 233);
}

.stage-number {
    color: rgb(232, 86, 108);
    font-size: 14px;
}

.stage-name {
    color: rgb(107, 67, 48);
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 4px 0;
}

.stage-stars {
    color: rgb(242, 169, 0);
    font-size: 22px;
}

.stars {
    color: rgb(242, 169, 0);
    font-size: 54px;
    letter-spacing: 8px;
}

.stat {
    font-size: 18px;
    color: rgb(122, 80, 56);
    margin: 2px 0;
}

.note {
    font-size: 15px;
    color: rgb(160, 122, 98);
    margin: 6px 0 10px 0;
    white-space: normal;
    -unity-text-align: middle-center;
}

.error-message {
    color: rgb(170, 60, 60);
}
